# اجرای محلی PGlite (حالت توسعه بدون نصب Postgres)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres
# در حالت dev اگر DATABASE_URL تنظیم نشود، سرور PGlite در پورت 55432 اجرا می‌شود.
DEV_PGLITE=1

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# آدرس عمومی برنامه برای ساخت لینک اعلان‌ها و CORS
APP_ORIGIN=http://localhost:5173
# راز امضا/هش — در تولید الزامی و تصادفی
SESSION_SECRET=dev-only-session-secret-change-me-000000000000
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_BYTES=5242880
# فعال‌سازی خروجی ایمیل اعلان‌ها (خالی = خاموش)
SMTP_URL=
# حساب‌های دمو فقط در محیط غیرتولید
SEED_DEMO=1
