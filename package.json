{
  "name": "payesh2",
  "version": "0.1.0",
  "private": true,
  "description": "پایش ۲ — سامانه مدیریت هوشمند مدرسه",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:seed": "npm --workspace apps/api run db:seed",
    "build": "npm --workspace apps/web run build && npm --workspace apps/api run build",
    "build:standalone": "npm --workspace apps/web exec -- vite build --mode standalone",
    "artifact:html": "npm run build:standalone && node scripts/build-standalone-html.mjs",
    "artifact:exe": "node scripts/build-exe.mjs --target win-x64",
    "test:e2e:standalone": "node scripts/e2e-standalone.mjs",
    "release:assets": "npm run build && npm run artifact:html && npm run artifact:exe && npm run verify:win && npm run artifact:exe:linux && node scripts/build-release-zips.mjs",
    "start": "npm --workspace apps/api run start",
    "lint": "eslint .",
    "typecheck": "npm --workspace apps/api run typecheck && npm --workspace apps/web run typecheck",
    "test": "npm --workspace apps/api run test && npm --workspace apps/web run test",
    "test:api": "npm --workspace apps/api run test",
    "test:web": "npm --workspace apps/web run test",
    "test:load": "npm --workspace apps/api run test:load",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e:product": "node scripts/e2e-product.mjs",
    "verify:win": "node scripts/verify-win-artifact.mjs",
    "artifact:exe:linux": "node scripts/build-exe.mjs --target linux-x64",
    "test:e2e:desktop": "node scripts/e2e-desktop.mjs",
    "verify:apk": "node scripts/verify-apk.mjs",
    "apk:meta": "node scripts/apk-meta.mjs",
    "build:android": "cd apps/android && gradle assembleRelease"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@sparticuz/chromium": "^131.0.1",
    "eslint": "^9.39.1",
    "postject": "^1.0.0-alpha.6",
    "puppeteer-core": "^23.11.1",
    "resedit": "^3.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
